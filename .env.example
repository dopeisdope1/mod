# Copier ce fichier en ".env" (local) ou renseigner ces variables dans Vexa Node. Ne JAMAIS committer ".env".

# Token du bot Discord "Moderation" (obligatoire)
DISCORD_TOKEN=

# Optionnel — IDs Discord (séparés par des virgules) ayant un accès propriétaire.
BOT_OWNER_IDS=

# API du panel (discord-bots-panel). Sans PANEL_API_KEY, l'API est désactivée.
# PANEL_API_PORT : le port alloué à cette instance par l'hébergeur (défaut 4003).
PANEL_API_KEY=
PANEL_API_PORT=

# Dossier des données persistantes (JSON). Défaut : ./data dans le projet.
# Sur l'hébergeur, pointer vers un dossier persistant (ex: /home/container/data).
DATA_DIR=

# Optionnels — partage de fichiers avec un AUTRE bot (même machine uniquement).
# Une instance Vexa Node étant isolée, laisser VIDE : stockage local indépendant.
PERMISSIONS_FILE=
MODLOG_FILE=
MUTE_DATA_DIR=
